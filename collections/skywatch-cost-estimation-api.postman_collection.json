            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"start_date\": \"<date>\",\n  \"end_date\": \"<date>\",\n  \"aoi\": {\n    \"type\": \"<string>\"\n  },\n  \"output\": {\n    \"id\": \"<string>\",\n    \"format\": \"<string>\",\n    \"mosaic\": \"<string>\"\n  },\n  \"budget_per_km2\": \"<number>\",\n  \"max_cost\": \"<number>\",\n  \"cloud_cover_percentage\": \"<number>\",\n  \"min_aoi_coverage_percentage\": \"<number>\",\n  \"resolution_low\": \"<number>\",\n  \"resolution_high\": \"<number>\",\n  \"interval\": \"<string>\",\n  \"result_delivery\": {\n    \"max_latency\": \"<string>\",\n    \"priorities\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"tags\": [\n    {\n      \"label\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"label\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ],\n  \"status\": \"<string>\",\n  \"sources\": {\n    \"include\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
