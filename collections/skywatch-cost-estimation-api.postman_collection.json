                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"<string>\",\n  \"start_date\": \"<date>\",\n  \"end_date\": \"<date>\",\n  \"aoi\": {\n    \"type\": \"Polygon\"\n  },\n  \"output\": {\n    \"id\": \"<string>\",\n    \"format\": \"geotiff\",\n    \"mosaic\": \"off\"\n  },\n  \"budget_per_km2\": \"<number>\",\n  \"max_cost\": \"<number>\",\n  \"cloud_cover_percentage\": \"<number>\",\n  \"min_aoi_coverage_percentage\": \"<number>\",\n  \"resolution_low\": \"<number>\",\n  \"resolution_high\": \"<number>\",\n  \"interval\": \"1d\",\n  \"result_delivery\": {\n    \"max_latency\": \"0d\",\n    \"priorities\": [\n      \"latest\",\n      \"highest_resolution\",\n      \"lowest_cost\"\n    ]\n  },\n  \"tags\": [\n    {\n      \"label\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"label\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ],\n  \"status\": \"active\",\n  \"sources\": {\n    \"include\": [\n      \"Pleiades\",\n      \"Spot\",\n      \"PlanetScope\",\n      \"Sentinel-2\"\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
